# Auto-detect text files and normalize to LF in the repo
* text=auto eol=lf

# Explicitly ensure source & project files use LF
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows scripts that must have CRLF (if you ever add any)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.dll binary
*.exe binary
*.png binary
